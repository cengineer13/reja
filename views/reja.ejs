<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" 
    rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" 
    crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" 
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" 
    crossorigin="anonymous"></script>
    
    <title>Reja project</title>
</head>
<body style="background-color: #f4f6f9; min-height: 100vh;">
    <div class="container py-5" style="max-width: 650px;">
        <h1 class="display-5 text-center mb-4 font-monospace">REJA VA MAQSADLAR</h1>
        <div class="bg-white p-4 shadow-sm rounded-3">
            <form id="create-form" action="/create-item" method="POST">
                <div class="d-flex align-items-center gap-3">
                    <input
                        id="create-field"
                        name="item"
                        autofocus
                        autocomplete="off"
                        class="form-control"
                        type="text"
                        placeholder="Yangi reja kiriting..."
                        style="flex: 1;"
                    />
                    <button class="btn btn-primary text-nowrap px-3" style="border-radius: 10px;">
                        Yangi reja qo'shish
                    </button>
                </div>
            </form>
        </div>
    </div>

</body>
</html>