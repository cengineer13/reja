<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>REJA</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" href="reja.css">

</head>

<body>
    <div class="container d-flex justify-content-center">
        <div class="main-container w-100">
            <h1 class="text-center header-title">
                <i class="fas fa-clipboard-list" style="color: #667eea; margin-right: 10px;"></i> REJA VA MAQSADLAR
            </h1>

            <div class="mb-5">
                <form id="create-form" action="/create-item" method="POST">
                    <div class="d-flex align-items-center">
                        <input id="create-field" name="reja" autofocus autocomplete="off" class="form-control mr-3"
                            type="text" placeholder="Yangi reja kiriting..." style="flex: 1" />
                        <button class="btn btn-add">
                            <i class="fas fa-plus"></i> Qo'shish
                        </button>
                    </div>
                </form>
            </div>

            <ul id="item-list" class="list-group pb-4">
                <% items.map(function(item) { %>
                    <li class="list-group-item d-flex align-items-center justify-content-between">
                        <span class="item-text">
                            <%=item.reja%>
                        </span>
                        <div class="action-btns">
                            <button data-id="<%=item._id%>" class="edit-me btn btn-edit">
                                <i class="fas fa-edit"></i> O'zgartirish
                            </button>
                            <button data-id="<%=item._id%>" class="delete-me btn btn-delete">
                                <i class="fas fa-trash-alt"></i> O'chirish
                            </button>
                        </div>
                    </li>
                    <% }) %>
            </ul>

            <div class="text-center mt-3">
                <button id="clean-all" class="btn btn-danger">
                    <i class="fas fa-broom"></i> Barchasini o'chirish
                </button>
            </div>
        </div>
    </div>

    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <script src="/browser.js"></script>
</body>

</html>