<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>REJA</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: #333;
        }

        .main-container {
            max-width: 800px;
            margin-top: 60px;
            margin-bottom: 60px;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
            padding: 40px;
        }

        .header-title {
            font-weight: 600;
            color: #343a40;
            margin-bottom: 30px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 2.2rem;
        }

        .form-control {
            border-radius: 30px;
            padding: 12px 25px;
            box-shadow: none;
            border: 1px solid #ced4da;
            font-size: 1.1rem;
        }

        .form-control:focus {
            box-shadow: 0 0 8px rgba(102, 126, 234, 0.5);
            border-color: #667eea;
        }

        .btn-add {
            border-radius: 30px;
            padding: 12px 30px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
            font-weight: 500;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

        .btn-add:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(118, 75, 162, 0.4);
            color: white;
        }

        .list-group-item {
            border: none;
            border-radius: 12px !important;
            margin-bottom: 12px;
            background-color: #f8f9fa;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
            padding: 15px 20px;
        }

        .list-group-item:hover {
            transform: translateX(5px);
            background-color: #ffffff;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .item-text {
            font-size: 1.15rem;
            font-weight: 400;
            color: #2c3e50;
            word-break: break-word;
        }

        .action-btns {
            display: flex;
            gap: 10px;
        }

        .action-btns .btn {
            border-radius: 10px;
            padding: 6px 12px;
            font-size: 0.9rem;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .btn-edit {
            background-color: #ffc107;
            border-color: #ffc107;
            color: #212529;
            font-weight: 500;
        }

        .btn-edit:hover {
            background-color: #e0a800;
            color: #212529;
            transform: scale(1.05);
        }

        .btn-delete {
            background-color: #dc3545;
            border-color: #dc3545;
            color: #fff;
            font-weight: 500;
        }

        .btn-delete:hover {
            background-color: #c82333;
            color: #fff;
            transform: scale(1.05);
        }

        #clean-all {
            border-radius: 30px;
            padding: 12px 35px;
            font-weight: 500;
            font-size: 1.1rem;
            background-color: #dc3545;
            border: none;
            transition: all 0.3s ease;
        }

        #clean-all:hover {
            background-color: #c82333;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(220, 53, 69, 0.4);
        }
    </style>
</head>

<body>
    <div class="container d-flex justify-content-center">
        <div class="main-container w-100">
            <h1 class="text-center header-title">
                <i class="fas fa-clipboard-list" style="color: #667eea; margin-right: 10px;"></i> REJA VA MAQSADLAR
            </h1>

            <div class="mb-5">
                <form id="create-form" action="/create-item" method="POST">
                    <div class="d-flex align-items-center">
                        <input id="create-field" name="reja" autofocus autocomplete="off" class="form-control mr-3"
                            type="text" placeholder="Yangi reja kiriting..." style="flex: 1" />
                        <button class="btn btn-add">
                            <i class="fas fa-plus"></i> Qo'shish
                        </button>
                    </div>
                </form>
            </div>

            <ul id="item-list" class="list-group pb-4">
                <% items.map(function(item) { %>
                    <li class="list-group-item d-flex align-items-center justify-content-between">
                        <span class="item-text">
                            <%=item.reja%>
                        </span>
                        <div class="action-btns">
                            <button data-id="<%=item._id%>" class="edit-me btn btn-edit">
                                <i class="fas fa-edit"></i> O'zgartirish
                            </button>
                            <button data-id="<%=item._id%>" class="delete-me btn btn-delete">
                                <i class="fas fa-trash-alt"></i> O'chirish
                            </button>
                        </div>
                    </li>
                    <% }) %>
            </ul>

            <div class="text-center mt-3">
                <button id="clean-all" class="btn btn-danger">
                    <i class="fas fa-broom"></i> Barchasini o'chirish
                </button>
            </div>
        </div>
    </div>

    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <script src="/browser.js"></script>
</body>

</html>