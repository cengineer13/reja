<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css" >
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" 
    rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" 
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <title>Portfolio</title>
</head>
<body>
    <div class="frame">
        <div class="main_frame">
            <div class="left_frame">
                <div class="left_profile">
                    <div class="profile_image"> <img src="/author/images/my_image.jpg" alt="Profile Image" class="profile_image"></div>
                    <div class="profil_name"><%=user.name%></div>
                    <div class="profil_profession"><%=user.profession%></div>
                    <div class="profil_socials">
                        <a class="social_link_href" href="#"><div class="icon"><img src="/author/icons/social/Facebook.svg" class="icon-1" alt="Facebook"/></div></a>
                        <a class="social_link_href" href="#"><div class="icon"><img src="/author/icons/social/Instagram.svg" class="icon-1" alt="Instagram"/></div></a>
                        <a class="social_link_href" href="#"><div class="icon"><img src="/author/icons/social/Linkeding.svg" class="icon-1" alt="LinkedIn"/></div></a>
                        <a class="social_link_href" href="#"><div class="icon"><img src="/author/icons/social/Twitter.svg" class="icon-1" alt="Twitter"/></div></a>
                        <a class="social_link_href" href="#"><div class="icon"><img src="/author/icons/social/Youtube.svg" class="icon-1" alt="Youtube"/></div></a>
                        <a class="social_link_href" href="#"><div class="icon"><img src="/author/icons/social/Dribbble.svg" class="icon-1" alt="Dribbble"/></div></a>
                    </div>

                <div class="marginer"></div>

                <div class="left_info">
                    <div class="info_row"><div class="info_value">Age:</div><div>32</div></div>
                    <div class="info_row"><div class="info_value">Residence:</div><div>BD</div></div>
                    <div class="info_row"><div class="info_value">Freelance:</div><div style="color: #7eb942;">Available</div></div>
                    <div class="info_row"><div class="info_value">Address:</div><div>Busan, South Korea</div></div>
                </div>
                <div class="marginer"></div>
                <div class="left_languages">
                    <div class="lang_title">Languages</div>
                    <div class="lang_row">
                        <div class="lang">Uzbek</div>
                        <div class="lang_procent">100%</div>
                    </div>
                    <div class="lang_progress" style="width: 100%;">Progress</div>
                    
                    <div class="lang_row">
                        <div class="lang">English</div>
                        <div class="lang_procent">70%</div>
                    </div>
                     <div class="lang_progress" style="width: 100%;">Progress</div>
                    
                    <div class="lang_row">
                        <div class="lang">Korean</div>
                        <div class="lang_procent">60%</div>
                    </div>
                     <div class="lang_progress" style="width: 80%;">Progress</div>
                </div>
                <div class="marginer"></div>
                <div class="left_skills">skills</div>
                <div class="marginer">margier</div>
                <div class="left_extra_skills">extra skills</div>
            
            </div> <!-- Left Frame End -->
            
            
            
            <!-- Middle Frame -->
            <div class="middle_frame"></div>

            <!-- Right Frame -->
            <div class="right_frame"></div>
        </div>
    </div>

</body>
</html>